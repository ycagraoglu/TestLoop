{
  "name": "testloop",
  "version": "0.5.0",
  "description": "Agent-native ASP.NET Core API testing, diagnosis, repair, review, and retesting.",
  "type": "module",
  "bin": { "testloop": "./bin/testloop.js" },
  "files": ["bin", "src", "scripts", "skills", "agents", "schemas", "templates", ".claude-plugin", "README.md", "LICENSE", "CHANGELOG.md"],
  "scripts": {
    "test": "node --test",
    "check": "node scripts/check.js",
    "verify": "npm run check && npm test && npm run pack:check",
    "pack:check": "node scripts/package-check.js",
    "prepack": "npm run check && npm test"
  },
  "engines": { "node": ">=20" },
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/ycagraoglu/TestLoop.git" },
  "bugs": { "url": "https://github.com/ycagraoglu/TestLoop/issues" },
  "homepage": "https://github.com/ycagraoglu/TestLoop#readme",
  "publishConfig": { "access": "public", "provenance": true },
  "keywords": ["aspnetcore", "api-testing", "agents", "openapi", "ef-core"]
}
