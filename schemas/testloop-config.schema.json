{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://testloop.dev/schemas/testloop-config.schema.json",
  "title": "TestLoop configuration",
  "type": "object",
  "required": ["baseUrl", "scenarios"],
  "properties": {
    "root": { "type": "string" },
    "runId": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["smoke", "standard", "deep"] },
    "baseUrl": { "type": "string", "format": "uri" },
    "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 300000 },
    "stopOnFailure": { "type": "boolean" },
    "auth": {
      "type": "object",
      "properties": {
        "type": { "enum": ["none", "bearer", "login"] },
        "token": { "type": "string" },
        "tokenEnv": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "method": { "type": "string" },
        "body": { "type": "object" },
        "tokenPath": { "type": "string" }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "method", "path"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"] },
          "path": { "type": "string", "minLength": 1 },
          "expectedStatuses": {
            "type": "array",
            "items": { "type": "integer", "minimum": 100, "maximum": 599 }
          },
          "body": { "type": "object" },
          "headers": { "type": "object", "additionalProperties": { "type": "string" } },
          "capture": { "type": "object", "additionalProperties": { "type": "string" } },
          "requestModel": { "type": "object" },
          "validator": { "type": ["object", "null"] },
          "fixtureSources": { "type": "object" }
        }
      }
    }
  },
  "additionalProperties": true
}
