{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://testloop.dev/schemas/testloop-config.schema.json",
  "title": "TestLoop configuration",
  "type": "object",
  "required": [
    "baseUrl",
    "scenarios"
  ],
  "properties": {
    "root": {
      "type": "string"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "smoke",
        "standard",
        "deep"
      ]
    },
    "baseUrl": {
      "type": "string",
      "format": "uri"
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 100,
      "maximum": 300000
    },
    "stopOnFailure": {
      "type": "boolean"
    },
    "requireApproval": {
      "type": "boolean"
    },
    "maxCreationDepth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "security": {
      "type": "object",
      "properties": {
        "allowPrivateNetwork": {
          "type": "boolean",
          "default": false
        },
        "allowedHosts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "allowedCommands": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "allowedCommandDirectories": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "inheritedEnv": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "maxResponseBytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 20000000
        },
        "maxRoleOutputBytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 10000000
        }
      },
      "additionalProperties": false
    },
    "auth": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "none",
            "bearer",
            "login"
          ]
        },
        "tokenEnv": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "method": {
          "type": "string"
        },
        "body": {
          "type": "object"
        },
        "tokenPath": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "roles": {
      "type": "object",
      "properties": {
        "diagnose": {
          "$ref": "#/$defs/role"
        },
        "fix": {
          "$ref": "#/$defs/role"
        },
        "review": {
          "$ref": "#/$defs/role"
        },
        "cwd": {
          "type": "string"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 300000
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "method",
          "path"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "enum": [
              "GET",
              "POST",
              "PUT",
              "PATCH",
              "DELETE",
              "HEAD",
              "OPTIONS"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "expectedStatuses": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 100,
              "maximum": 599
            }
          },
          "body": {
            "type": "object"
          },
          "headers": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "capture": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "requestModel": {
            "type": "object"
          },
          "validator": {
            "type": [
              "object",
              "null"
            ]
          },
          "fixtureSources": {
            "type": "object"
          }
        }
      }
    },
    "openApiUrl": {
      "type": "string",
      "format": "uri"
    },
    "regressionCheck": {
      "type": "boolean"
    },
    "cleanup": {
      "type": "boolean"
    }
  },
  "$defs": {
    "role": {
      "type": "object",
      "required": [
        "command"
      ],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
