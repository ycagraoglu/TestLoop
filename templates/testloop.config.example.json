{
  "root": ".",
  "runId": "local-products",
  "mode": "standard",
  "baseUrl": "http://127.0.0.1:5099",
  "timeoutMs": 30000,
  "stopOnFailure": true,
  "security": {
    "allowPrivateNetwork": true,
    "allowedHosts": ["127.0.0.1"],
    "allowedCommands": ["node"],
    "inheritedEnv": ["PATH", "HOME", "USERPROFILE", "TMP", "TEMP"],
    "maxResponseBytes": 2000000,
    "maxRoleOutputBytes": 1000000
  },
  "auth": {
    "type": "login",
    "url": "http://127.0.0.1:5099/api/auth/token",
    "method": "POST",
    "body": {
      "email": { "$env": "TESTLOOP_LOGIN_EMAIL" },
      "password": { "$env": "TESTLOOP_LOGIN_PASSWORD" }
    },
    "tokenPath": "data.accessToken"
  },
  "roles": {
    "diagnose": { "command": ["node", "./agents/diagnose-adapter.js"] },
    "fix": { "command": ["node", "./agents/fix-adapter.js"] },
    "review": { "command": ["node", "./agents/review-adapter.js"] }
  },
  "scenarios": [
    {
      "id": "create-product",
      "method": "POST",
      "path": "/api/products",
      "expectedStatuses": [200, 201],
      "requestModel": {
        "name": "CreateProductRequest",
        "properties": [
          { "name": "Name", "type": "string", "required": true },
          { "name": "Price", "type": "decimal", "required": true },
          { "name": "CategoryId", "type": "Guid", "required": true }
        ],
        "dependencies": [
          { "property": "CategoryId", "entity": "Category" }
        ]
      },
      "fixtureSources": {
        "Category": [
          {
            "type": "http-list",
            "url": "http://127.0.0.1:5099/api/categories",
            "itemsPath": "data",
            "idProperty": "id",
            "predicates": [
              { "property": "isActive", "operator": "truthy" }
            ]
          }
        ]
      },
      "capture": {
        "productId": "data.id"
      }
    },
    {
      "id": "get-product",
      "method": "GET",
      "path": "/api/products/{create-product.productId}",
      "expectedStatuses": [200]
    }
  ]
}
